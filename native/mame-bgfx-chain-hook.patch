+namespace {
+
+std::mutex s_request_mutex;
+std::string s_requested_chain;
+std::atomic<uint32_t> s_request_serial(0);
+
+} // anonymous namespace
+
+void chain_manager::request_chain(std::string_view name)
+{
+	std::lock_guard<std::mutex> lock(s_request_mutex);
+	s_requested_chain.assign(name);
+	s_request_serial.fetch_add(1, std::memory_order_release);
+}
+
+void chain_manager::apply_requested_chain()
+{
+	// Screens are counted on the first frame; keep the request pending until then.
+	uint32_t const serial = s_request_serial.load(std::memory_order_acquire);
+	if (serial == m_applied_request || m_screen_count == 0)
+		return;
+	m_applied_request = serial;
+
+	std::string name;
+	{
+		std::lock_guard<std::mutex> lock(s_request_mutex);
+		name = s_requested_chain;
+	}
+
+	auto const found = std::find_if(
+			m_available_chains.begin(),
+			m_available_chains.end(),
+			[&name] (auto const &avail) { return avail.m_name == name; });
+	if (m_available_chains.end() == found)
+	{
+		osd_printf_warning("BGFX: Requested chain %s not found\n", name);
+		return;
+	}
+
+	// Same path as the UI's per-screen effect slider: reload chains, keep other screens' sliders.
+	int32_t const chainnum = found - m_available_chains.begin();
+	for (uint32_t screen = 0; screen < m_screen_count && screen < m_current_chain.size(); screen++)
+	{
+		if (m_current_chain[screen] != chainnum)
+			slider_changed(screen, nullptr, chainnum);
+	}
+}
