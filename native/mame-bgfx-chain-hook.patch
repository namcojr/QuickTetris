+// Host app hook: com.namco.quicktetris.MameActivity.nativeSetScreenChain(String).
+extern "C" JNIEXPORT void JNICALL Java_com_namco_quicktetris_MameActivity_nativeSetScreenChain(JNIEnv *env, jclass, jstring name)
+{
+	char const *const utf = name ? env->GetStringUTFChars(name, nullptr) : nullptr;
+	if (!utf)
+		return;
+	chain_manager::request_chain(utf);
+	env->ReleaseStringUTFChars(name, utf);
+}
